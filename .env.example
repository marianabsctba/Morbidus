# Copie para .env e troque todos os segredos antes de qualquer ambiente compartilhado.
LOG_LEVEL=INFO

POSTGRES_USER=morbidus
POSTGRES_PASSWORD=troque-esta-senha

MINIO_ACCESS_KEY=morbidus
MINIO_SECRET_KEY=troque-esta-senha

# identity-svc
ADMIN_TOKEN=troque-este-token
API_KEY_PEPPER=troque-este-segredo

# query-svc
AUDIT_CPF_SALT=troque-este-segredo

# provider-svc: "mock" só em desenvolvimento. Em produção, deixe vazio até ter Serpro ou CRC,
# senão o mock responde "falecido" para CPFs de teste.
ENABLED_PROVIDERS=mock

# Produção (docker-compose.prod.yml)
# DOMAIN=morbidus.besafe.academy
# ACME_EMAIL=seu-email@dominio
# PUBLIC_ENTRYPOINT=websecure
# ADMIN_ALLOWED_IPS=203.0.113.10/32

# crawler-svc: "all" liga todas as fontes reais (ver docs/fontes-obituarios.md).
# Curitiba e Campo Grande guardam só 2 dias, então o intervalo precisa ser curto.
ENABLED_SPIDERS=all
CRAWL_INTERVAL_MINUTES=180
